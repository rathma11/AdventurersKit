# CurseForge / BigWigs packager (https://github.com/BigWigsMods/packager) recipe.
# The repository root holds the three addon folders; the package is these folders at the zip root.
package-as: AdventurersKit

move-folders:
  AdventurersKit/AdventurersKit: AdventurersKit
  AdventurersKit/AdventurersKit_Bags: AdventurersKit_Bags
  AdventurersKit/AdventurersKit_Buffs: AdventurersKit_Buffs

ignore:
  - tests
  - docs
  - releases
  - DESIGN.md
  - FEATURES.md
  - README.md
  - CHANGELOG.md
  - LICENSE.md
  - "*.bak"
  - .gitignore
  - .github

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

enable-nolib-creation: no
